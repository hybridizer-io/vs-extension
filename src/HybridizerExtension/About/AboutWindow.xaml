<Window x:Class="HybridizerExtension.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Hybridizer"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Grid.Column="0" Grid.Row="0"
               Source="pack://application:,,,/HybridizerExtension;component/Resources/Hybridizer256x256.png"
               Width="96" VerticalAlignment="Top" Margin="0,4,24,0"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <StackPanel Grid.Column="1" Grid.Row="0" MinWidth="240">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock x:Name="VersionText" Margin="0,0,0,4" />
            <TextBlock x:Name="CopyrightText" Margin="0,0,0,4" />
            <TextBlock x:Name="RightsText" Margin="0,0,0,12" />
            <TextBlock>
                <Hyperlink x:Name="WebsiteLink" RequestNavigate="OnRequestNavigate">
                    <Run x:Name="WebsiteText" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <Button Grid.Column="1" Grid.Row="1"
                Content="OK" Width="80" Margin="0,20,0,0"
                HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" />
    </Grid>
</Window>
